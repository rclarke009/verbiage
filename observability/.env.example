# Copy to observability/.env and fill in for email alerts from local Grafana.
# Also set addresses: in grafana/provisioning/alerting/alert_resources.yaml.
# Profile → Email in the Grafana UI is NOT used for alerting.

# SMTP — required for Grafana to actually send mail (local Docker stack)
# Gmail example: host smtp.gmail.com:587 with an app password
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=alerts@example.com
GF_SMTP_FROM_NAME=Verbiage Alerts
